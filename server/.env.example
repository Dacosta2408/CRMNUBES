# GBK CRM - Backend Environment Configuration

# Server Settings
PORT=3001
NODE_ENV=development

# PostgreSQL Database Configuration
PGHOST=localhost
PGPORT=5432
PGDATABASE=gbk_crm
PGUSER=postgres
PGPASSWORD=your_secure_password_here

# Connection Pool Settings
PGMAX_CONNECTIONS=20
PGIDLE_TIMEOUT_MS=30000

# Google Gemini API Key (Server-side ONLY - Never expose to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Z Drive Bridge Authentication Token
GBK_BRIDGE_TOKEN=gbk-local-secret-2024
