{
  "name": "gbk-crm-backend",
  "version": "1.0.0",
  "description": "PostgreSQL-backed API server for GBK CRM",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:init": "node -e \"console.log('Use psql -U postgres -d gbk_crm -f src/schema.sql')\""
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
